{
  "name": "fpsviet-com",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "verify": "npm run data:validate && npm run lint && npm run build",
    "deploy": "npm run verify && vercel --prod --yes",
    "seed": "tsx prisma/seed.ts",
    "seed:pg": "node --env-file=.env.local scripts/supabase-seed.mjs",
    "data:scrape": "node scripts/scrape-real-game-data.mjs",
    "data:prices": "node scripts/scrape-official-game-prices.mjs",
    "data:discover-games": "node scripts/discover-reference-games.mjs",
    "data:promote-games": "node scripts/promote-game-candidates.mjs",
    "data:backfill-benchmarks": "node scripts/backfill-missing-benchmarks.mjs",
    "data:gpu-images": "node scripts/generate-gpu-images.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "data:update": "npm run data:validate && npm run build",
    "data:images": "node scripts/scrape-game-images.mjs",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "latest",
    "date-fns": "latest",
    "next": "^15.5.18",
    "next-seo": "latest",
    "pg": "^8.20.0",
    "prisma": "^6.19.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "latest",
    "redis": "^5.12.1",
    "slugify": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
